rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Logado e com e-mail confirmado
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function me() {
      return request.auth.token.email.lower();
    }
    // Liberado pelo administrador (existe em /members/<email>)
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(me()));
    }
    function isAdmin() {
      return isMember() && get(/databases/$(database)/documents/members/$(me())).data.role == 'admin';
    }

    // Quem configurou o app primeiro (o administrador inicial). Só pode ser criado uma vez.
    match /meta/owner {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.email == me()
        && getAfter(/databases/$(database)/documents/members/$(me())).data.role == 'admin';
    }

    // Lista de quem pode usar o app
    match /members/{email} {
      allow read: if signedIn() && (email == me() || isMember());
      allow create: if isAdmin()
        || (signedIn() && email == me()
            && request.resource.data.role == 'admin'
            && !exists(/databases/$(database)/documents/meta/owner)
            && getAfter(/databases/$(database)/documents/meta/owner).data.email == me());
      allow update, delete: if isAdmin() && email != me();
    }

    // Dados do app: só quem foi liberado
    match /config/{doc} {
      allow read, write: if isMember();
    }
    match /days/{day} {
      allow read, write: if isMember();
    }
  }
}
