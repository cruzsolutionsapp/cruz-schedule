rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function me() {
      return request.auth.token.email.lower();
    }
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(me()));
    }
    function member() {
      return get(/databases/$(database)/documents/members/$(me())).data;
    }
    function isAdmin() {
      return isMember() && member().role == 'admin';
    }
    // Permissão marcada na aba Acesso (admin tem todas; sem a lista = todas, como era antes)
    function can(p) {
      return isMember() && (member().role == 'admin' || member().get('perms', {}).get(p, true) == true);
    }
    // Trabalhador ligado a este login (aba Acesso → "É o trabalhador")
    function myWorker() {
      return member().get('worker', '');
    }
    function isMyPhoto(d) {
      return isMember() && myWorker() != '' && d.driver == myWorker();
    }
    // O trabalhador ligado a este login está com veículo nessa obra, nesse dia? (lista "drivers" na escala do dia)
    function isDriverOf(date, jobId) {
      return myWorker() != '' && exists(/databases/$(database)/documents/days/$(date))
        && myWorker() in get(/databases/$(database)/documents/days/$(date)).data.get('drivers', {}).get(jobId, []);
    }
    function photoOk(d) {
      return d.by == me() && d.date is string && d.jobId is string && d.driver is string
        && (can('fotos') || (isMyPhoto(d) && isDriverOf(d.date, d.jobId)));
    }
    // Login do totem do shop: só faz check-in (permissão 'totem' tem que estar marcada de propósito)
    function isTotem() {
      return isMember() && member().get('perms', {}).get('totem', false) == true;
    }
    // Escala do dia: só os campos certos, data batendo com o documento e no máximo 150 obras
    function dayOk(day) {
      return request.resource.data.keys().hasOnly(['date', 'jobs', 'sent', 'drivers'])
        && request.resource.data.date == day
        && request.resource.data.jobs is list && request.resource.data.jobs.size() <= 150;
    }
    // Cadastro: listas com tamanho razoável (evita alguém encher o banco)
    function rosterOk() {
      return !('workers' in request.resource.data) || (request.resource.data.workers is list && request.resource.data.workers.size() <= 1000);
    }
    // Financeiro (T&M e horas): tem que estar marcado de propósito (admin tem)
    function fin() {
      return isMember() && (member().role == 'admin' || member().get('perms', {}).get('financeiro', false) == true);
    }
    // T&M: só os campos certos, id = data_obra, até 60 linhas, assinatura pequena
    function tmOk(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['date', 'jobId', 'site', 'company', 'location', 'jobNo', 'rows', 'materials', 'status', 'no', 'sign', 'tmh', 'driver', 'by', 'atMs', 'sentAt', 'invoice', 'log'])
        && d.date is string && d.jobId is string && id == d.date + '_' + d.jobId
        && d.rows is list && d.rows.size() <= 60
        && (!('materials' in d) || (d.materials is string && d.materials.size() <= 5000))
        && (!('log' in d) || (d.log is list && d.log.size() <= 200))
        && (!('sign' in d) || d.sign == null || (d.sign is map && (!('img' in d.sign) || d.sign.img == null || (d.sign.img is string && d.sign.img.size() < 300000))));
    }
    // digitou a senha de novo há pouco (s segundos)
    function recent(s) {
      return request.time < timestamp.value((request.auth.token.auth_time + s) * 1000);
    }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /meta/owner {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.email == me()
        && getAfter(/databases/$(database)/documents/members/$(me())).data.role == 'admin';
    }

    match /members/{email} {
      allow read: if signedIn() && (email == me() || isAdmin());
      allow create: if isAdmin()
        || (signedIn() && email == me()
            && request.resource.data.role == 'admin'
            && !exists(/databases/$(database)/documents/meta/owner)
            && getAfter(/databases/$(database)/documents/meta/owner).data.email == me());
      allow update, delete: if isAdmin() && email != me();
    }

    // Cadastro: quem edita escala pode salvar endereços novos e tempos de viagem
    // Pedidos de acesso: a própria pessoa cria o dela; só o admin vê e apaga
    match /requests/{email} {
      allow create, update: if signedIn() && email == me()
        && request.resource.data.email == me()
        && request.resource.data.keys().hasOnly(['email', 'name', 'at'])
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 60));
      allow read: if isAdmin() || (signedIn() && email == me());
      allow delete: if isAdmin();
    }

    match /config/roster {
      allow read: if isMember();
      allow create: if can('cadastro') && rosterOk();
      allow update: if (can('cadastro') || (can('escala') && onlyChanged(['companies', 'travel', 'offices']))) && rosterOk();
    }

    // "Atualizar a TV": quem edita escala manda a TV recarregar
    match /config/tvping {
      allow read: if isMember();
      allow write: if can('escala') && request.resource.data.keys().hasOnly(['at', 'by']);
    }

    // Telefones: só quem tem "Telefones e avisar equipe"
    match /config/phones {
      allow read, write: if can('telefones');
    }

    // Fotos da obra (versão de teste: guardadas no banco).
    // /photos = dados da foto (leve), /photoThumb = miniatura, /photoFull = foto grande.
    // O motorista vê só as fotos em que ele é o motorista; quem tem "Ver todas as fotos" vê tudo.
    match /photos/{id} {
      allow read: if can('fotos') || isMyPhoto(resource.data);
      allow create: if photoOk(request.resource.data) && !('data' in request.resource.data)
        && (!('thumb' in request.resource.data) || request.resource.data.thumb.size() < 60000);
      allow delete: if can('fotos') || (isMember() && resource.data.by == me());
    }
    match /photoThumb/{id} {
      allow read: if can('fotos') || isMyPhoto(resource.data);
      allow create: if photoOk(request.resource.data) && request.resource.data.thumb.size() < 60000;
      allow delete: if can('fotos') || (isMember() && resource.data.by == me());
    }
    match /photoFull/{id} {
      allow read: if can('fotos') || isMyPhoto(resource.data);
      allow create: if photoOk(request.resource.data) && request.resource.data.data.size() < 900000;
      allow delete: if can('fotos') || (isMember() && resource.data.by == me());
    }

    // Presença: o motorista marca quem veio na obra dele; o escritório (quem edita escala) também pode
    match /attendance/{id} {
      allow read: if isMember();
      allow create, update: if (can('escala')
          || (isMember() && myWorker() != '' && request.resource.data.driver == myWorker()
              && (resource == null || resource.data.driver == myWorker())
              && isDriverOf(request.resource.data.date, request.resource.data.jobId))
          || (isTotem() && (resource == null
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['people', 'times', 'by', 'at', 'atMs', 'driver']))))
        && request.resource.data.date is string && request.resource.data.jobId is string
        && request.resource.data.people is map;
    }

    // Day off: todo mundo do app vê; só o administrador marca/tira (pelo Calendário)
    match /dayoff/{day} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Histórico da escala (fotos a cada 5 min): todos do app veem; quem edita escala grava; só admin apaga
    match /dayhist/{id} {
      allow read: if isMember();
      allow create, update: if can('escala') && request.resource.data.date is string
        && request.resource.data.keys().hasOnly(['date', 'at', 'by', 'jobs', 'sent', 'drivers', 'n', 'people', 'left'])
        && request.resource.data.jobs is list && request.resource.data.jobs.size() <= 150;
      allow delete: if isAdmin();
    }

    // Time & Material digital (folha de horas da obra)
    // Rascunho: o escritório (escala) ou o motorista da obra preenche. Depois de enviada ("signed") fica trancada:
    // só o Financeiro mexe no Invoice # / faturada, e só o admin destranca.
    match /tm/{id} {
      allow read: if resource == null || fin() || can('escala')
        || (isMember() && (resource.data.by == me() || (myWorker() != '' && resource.data.driver == myWorker())
            || isDriverOf(resource.data.date, resource.data.jobId)));
      allow create: if tmOk(id) && request.resource.data.status in ['draft', 'pending']
        && (can('escala') || isDriverOf(request.resource.data.date, request.resource.data.jobId));
      allow update: if tmOk(id) && (
          isAdmin()
          || (resource.data.status in ['draft', 'pending'] && request.resource.data.status in ['draft', 'pending', 'signed']
              && (request.resource.data.status != 'signed' || (request.resource.data.no is string && request.resource.data.no.size() > 0))
              && (can('escala') || isDriverOf(request.resource.data.date, request.resource.data.jobId)))
          || (fin() && resource.data.status in ['signed', 'invoiced'] && request.resource.data.status in ['signed', 'invoiced']
              && onlyChanged(['invoice', 'status', 'log'])));
      // excluir: só admin, e só logo depois de digitar a senha de novo (até 5 min)
      allow delete: if isAdmin() && request.time < timestamp.value((request.auth.token.auth_time + 300) * 1000);
    }
    // T&M excluídas: cópia + quem excluiu, quando e por quê. Ninguém altera nem apaga esse registro.
    match /tmdeleted/{id} {
      allow read: if isAdmin() || fin();
      allow create: if isAdmin() && request.resource.data.deletedBy == me()
        && request.resource.data.keys().hasOnly(['tmId', 'date', 'company', 'no', 'deletedBy', 'deletedAt', 'reason', 'data'])
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 200;
      allow update, delete: if false;
    }
    // Numeração das T&M digitais: só sobe de 1 em 1 (nunca repete)
    match /counters/tm {
      allow read: if isMember();
      allow create: if isMember() && (can('escala') || myWorker() != '') && request.resource.data.keys().hasOnly(['next']) && request.resource.data.next == 2;
      allow update: if isMember() && (can('escala') || myWorker() != '') && request.resource.data.keys().hasOnly(['next']) && request.resource.data.next == resource.data.next + 1;
    }

    // 💲 Valores por hora dos funcionários: só admin/Financeiro e só logo depois de digitar a senha (10 min)
    match /pay/{doc} {
      allow read, write: if fin() && recent(600);
    }
    // Registro de quem abriu/mudou os valores (ninguém altera nem apaga)
    match /paylog/{id} {
      allow create: if fin() && request.resource.data.by == me();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Escala de cada dia
    match /days/{day} {
      allow read: if isMember();
      allow create: if can('escala') && dayOk(day);
      allow update: if dayOk(day) && (can('escala') && (can('apagar') || request.resource.data.jobs.size() >= resource.data.jobs.size()))
        || (can('telefones') && onlyChanged(['sent']));
      allow delete: if can('apagar');
    }
  }
}
